# Linux systemd 252+. Edit the fixed account/paths together before installation.
# Both instances use ONE config/database and its existing POSIX writer lock.
[Unit]
Description=SignalNest bounded %i collection
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=signalnest
Group=signalnest
WorkingDirectory=/opt/signalnest
ExecStart=/opt/signalnest/.venv/bin/signalnest scheduled-run --config /etc/signalnest/signalnest.toml --mode %i
Restart=no
TimeoutStartSec=15min
TimeoutStopSec=30s
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/signalnest
Environment=PYTHONDONTWRITEBYTECODE=1
StandardOutput=journal
StandardError=journal
LogNamespace=signalnest
SyslogIdentifier=signalnest-%i
