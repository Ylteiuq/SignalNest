# Dedicated CS database/channel; does not repoint the existing UC service.
[Unit]
Description=SignalNest CS bounded %i collection (mail disabled)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=signalnest
Group=signalnest
WorkingDirectory=/opt/signalnest
ExecStart=/opt/signalnest/.venv/bin/signalnest scheduled-run --config /etc/signalnest/cs.toml --mode %i
Restart=no
TimeoutStartSec=8min
TimeoutStopSec=30s
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/signalnest-cs
Environment=PYTHONDONTWRITEBYTECODE=1
StandardOutput=journal
StandardError=journal
LogNamespace=signalnest
SyslogIdentifier=signalnest-cs-%i
